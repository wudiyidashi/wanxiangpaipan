{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanxiang-paipan.local/schema/daliuren/classics/source.schema.json",
  "title": "Da Liu Ren classic source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources", "unregisteredCandidates"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "unregisteredCandidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "remoteFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format", "sizeBytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanLeafBase",
        "leafCount",
        "pdfPageBase",
        "mappingRule",
        "mappingStatus",
        "printedLeafScheme",
        "notes"
      ],
      "properties": {
        "scanLeafBase": {"type": ["integer", "null"], "minimum": 0},
        "leafCount": {"type": ["integer", "null"], "minimum": 1},
        "pdfPageBase": {"type": ["integer", "null"], "minimum": 1},
        "mappingRule": {
          "enum": [
            "pdfPageEqualsScanLeaf",
            "pdfPageEqualsScanLeafPlusOne",
            "nonLinear",
            "notApplicable",
            "unverified"
          ]
        },
        "mappingStatus": {
          "enum": ["verifiedFromScandata", "partial", "unverified", "notApplicable"]
        },
        "printedLeafScheme": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volumeLabel",
        "identifier",
        "accessUrl",
        "remoteFiles",
        "pagination"
      ],
      "properties": {
        "volumeLabel": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "accessUrl": {"type": "string", "format": "uri"},
        "remoteFiles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/remoteFile"}
        },
        "pagination": {"$ref": "#/$defs/pagination"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType",
        "title",
        "authorsEditors",
        "edition",
        "repository",
        "identifier",
        "accessUrl",
        "accessedAt",
        "verificationStatus",
        "locatorOnly",
        "usage",
        "ruleLayers",
        "volumes",
        "rightsNote",
        "limitations"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^dlr\\.source\\.[a-z0-9][a-z0-9.-]*$"
        },
        "sourceType": {
          "enum": ["scan", "transcription", "ocr", "commentary"]
        },
        "title": {"type": "string", "minLength": 1},
        "authorsEditors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "edition": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "accessUrl": {"type": "string", "format": "uri"},
        "accessedAt": {"type": "string", "format": "date"},
        "verificationStatus": {
          "enum": ["candidate", "metadataVerified", "scanVerified", "approved"]
        },
        "locatorOnly": {"type": "boolean"},
        "usage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "primaryBaseline",
              "judgmentBaseline",
              "externalCase",
              "supplement",
              "variantLocator",
              "searchLocator"
            ]
          }
        },
        "ruleLayers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pan",
              "shenjiang",
              "jiuzongmen",
              "derivedFacts",
              "shensha",
              "kejing",
              "bifa",
              "nianming",
              "classSpirit",
              "judgment",
              "timing",
              "externalCases"
            ]
          }
        },
        "volumes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/volume"}
        },
        "rightsNote": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "title", "status", "reason"],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^dlr\\.candidate\\.[a-z0-9][a-z0-9.-]*$"
        },
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["notLocated", "metadataIncomplete", "rejected"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
